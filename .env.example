# rag-engine 프로젝트 값 (키 아님). 복사해서 .env 로 쓰고 필요할 때만 바꾸세요.
GCP_PROJECT_ID=gen-lang-client-0939908286
# RAG Engine과 Vector Search가 같은 리전이어야 함. check에서 실패하면 us-east4 / europe-west3 등으로
GCP_LOCATION=asia-northeast3
RAG_NAME_PREFIX=rag
# 임베딩 모델과 차원은 반드시 일치 (text-multilingual-embedding-002=768, text-embedding-005=768, gemini-embedding-001=3072)
RAG_EMBEDDING_MODEL=text-multilingual-embedding-002
RAG_EMBEDDING_DIM=768
RAG_DISTANCE=DOT_PRODUCT_DISTANCE
RAG_DEPLOY_MACHINE=e2-standard-2
# 서비스 계정 키 방식일 때만 (gcloud ADC면 비워 두기). 키 파일은 secrets/ 에 (git 제외)
# GOOGLE_APPLICATION_CREDENTIALS=./secrets/sa.json
# upload 명령이 쓰는 버킷 (기본: <프로젝트ID>-rag-docs, 없으면 GCP_LOCATION에 생성)
# RAG_BUCKET=
